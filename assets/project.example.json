{
  "version": 2,
  "project": { "name": "my-project" },
  "repositories": {
    "related": [
      { "id": "api", "role": "service", "remote": "git@github.com:org/api.git", "remoteName": "origin" }
    ]
  },
  "standards": {
    "status": "approved",
    "sources": [{ "repository": "primary", "path": "AGENTS.md", "sha256": "<SHA-256>", "decision": "approved" }],
    "fallbacks": [".cayos/standards/typescript.md"],
    "approvedAt": "<ISO-8601>"
  },
  "architecture": {
    "status": "approved",
    "document": ".cayos/architecture.md",
    "followByDefault": true,
    "approvedAt": "<ISO-8601>"
  },
  "ticketProvider": { "type": "clickup", "binding": "mcp", "referencePattern": "^(clickup:)?[A-Za-z0-9_-]+$", "readOnly": true },
  "codeHost": { "type": "github", "remote": "origin", "autoMerge": false },
  "verification": {
    "repositories": [
      {
        "repository": "primary",
        "skill": ".cursor/skills/verify-web",
        "seam": "browser",
        "sourcePaths": ["src"],
        "browser": { "mcpServer": "chrome-agent-mcp", "debugPort": 9222 }
      },
      {
        "repository": "api",
        "skill": ".cursor/skills/verify-api",
        "seam": "http",
        "sourcePaths": ["src/server.ts"]
      }
    ]
  }
}
